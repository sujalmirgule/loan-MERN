// Prisma Schema for Loan Approve Platform
// Database: SQLite with WAL mode enabled

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. ADMIN USER
// -------------------------------------------------------------
model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         String    @default("ADMIN")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  disbursements Disbursement[]
}

// -------------------------------------------------------------
// 2. CUSTOMER
// -------------------------------------------------------------
model Customer {
  id              String    @id @default(uuid())
  mobile          String    @unique
  fullName        String
  email           String
  address         String
  state           String
  city            String
  aadhaarEncrypted String
  aadhaarMasked   String
  monthlyIncome   Float
  status          String    @default("ACTIVE") // ACTIVE, SUSPENDED, ARCHIVED
  kycStatus       String    @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED, REUPLOAD_REQUIRED
  isDeleted       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  loans           LoanApplication[]
  documents       LoanDocument[]
  documentRequests DocumentRequest[]
  agreements      LoanAgreement[]
  disbursements   Disbursement[]
  emiSchedules    EMISchedule[]
  payments        Payment[]
  notifications   Notification[]
  supportTickets  SupportTicket[]

  @@index([mobile])
  @@index([email])
  @@index([state])
  @@index([city])
  @@index([kycStatus])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 3. LOAN APPLICATION & LOAN
// -------------------------------------------------------------
model LoanApplication {
  id                   String    @id @default(uuid())
  applicationNumber    String    @unique // e.g. LA-2026-000001
  customerId           String
  customer             Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  requestedAmount      Float
  proposedAmount       Float?    // Admin proposed amount in offer workflow
  approvedAmount       Float?
  acceptedAmount       Float?    // Customer accepted offer amount
  
  interestType         String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  interestRate         Float     @default(12.0)
  interestCalcMethod   String    @default("REDUCING_BALANCE") // SIMPLE, REDUCING_BALANCE
  
  processingFeeType    String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  processingFeeValue   Float     @default(2.0)
  processingFeeAmount  Float     @default(0)
  
  tenureMonths         Int
  estimatedEmi         Float?    @default(0)
  finalEmi             Float?
  
  purpose              String?
  status               String    @default("SUBMITTED") 
  // DRAFT, SUBMITTED, UNDER_REVIEW, DOCUMENTS_REQUIRED, ON_HOLD, APPROVED, 
  // REJECTED, OFFER_PENDING_CUSTOMER, OFFER_ACCEPTED, OFFER_REJECTED

  rejectionReason      String?
  holdReason           String?
  docRequestReason     String?
  modifiedOfferAccepted Boolean?
  paymentStatus        String    @default("NOT_REQUIRED") // NOT_REQUIRED, PAYMENT_REQUIRED, UNDER_VERIFICATION, PAID
  
  reviewedBy           String?
  reviewedAt           DateTime?
  submittedAt          DateTime? @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  documents            LoanDocument[]
  documentRequests     DocumentRequest[]
  agreement            LoanAgreement?
  disbursements        Disbursement[]
  emiSchedules         EMISchedule[]
  payments             Payment[]

  @@index([applicationNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([submittedAt])
}

// -------------------------------------------------------------
// 4. LOAN DOCUMENT & KYC
// -------------------------------------------------------------
model LoanDocument {
  id               String           @id @default(uuid())
  loanId           String?
  loan             LoanApplication? @relation(fields: [loanId], references: [id], onDelete: SetNull)
  customerId       String
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  documentType     String           // AADHAAR_FRONT, AADHAAR_BACK, PAN, INCOME_PROOF, BANK_STATEMENT, OTHER
  fileName         String           // Display filename
  originalFileName String           @default("")
  storageKey       String           @default("")
  filePath         String
  fileUrl          String
  mimeType         String
  fileSize         Int
  status           String           @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED, REUPLOAD_REQUIRED
  rejectionReason  String?
  version          Int              @default(1)
  isCurrentVersion Boolean          @default(true)
  reviewedBy       String?
  reviewedAt       DateTime?
  uploadedAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt

  @@index([customerId])
  @@index([loanId])
  @@index([documentType])
  @@index([status])
  @@index([isCurrentVersion])
}

// -------------------------------------------------------------
// 4b. DOCUMENT REQUEST (Admin initiated)
// -------------------------------------------------------------
model DocumentRequest {
  id           String           @id @default(uuid())
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  loanId       String?
  loan         LoanApplication? @relation(fields: [loanId], references: [id], onDelete: SetNull)
  documentType String           // e.g. OTHER, BANK_STATEMENT, etc.
  title        String
  description  String?
  status       String           @default("PENDING") // PENDING, FULFILLED, CANCELLED
  requestedBy  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([customerId])
  @@index([loanId])
  @@index([status])
}

// -------------------------------------------------------------
// 5. LOAN AGREEMENT
// -------------------------------------------------------------
model LoanAgreement {
  id                   String          @id @default(uuid())
  loanId               String          @unique
  loan                 LoanApplication @relation(fields: [loanId], references: [id], onDelete: Restrict)
  customerId           String
  customer             Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  agreementVersion     String          @default("v1.0")
  agreementContentHtml String
  ipAddress            String?
  userAgent            String?
  acceptanceStatus     String          @default("PENDING") // PENDING, ACCEPTED
  acceptedAt           DateTime?
  createdAt            DateTime        @default(now())

  @@index([loanId])
  @@index([customerId])
}

// -------------------------------------------------------------
// 6. DISBURSEMENT
// -------------------------------------------------------------
model Disbursement {
  id                String          @id @default(uuid())
  loanId            String
  loan              LoanApplication @relation(fields: [loanId], references: [id], onDelete: Restrict)
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  amount            Float
  method            String          // BANK_TRANSFER, UPI
  referenceId       String          // UTR or Transaction Ref
  status            String          @default("COMPLETED") // PENDING, COMPLETED, FAILED
  notes             String?
  disbursedAt       DateTime        @default(now())
  
  createdByAdminId  String?
  admin             AdminUser?      @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([loanId])
  @@index([customerId])
  @@index([referenceId])
}

// -------------------------------------------------------------
// 7. EMI SCHEDULE
// -------------------------------------------------------------
model EMISchedule {
  id                String          @id @default(uuid())
  loanId            String
  loan              LoanApplication @relation(fields: [loanId], references: [id], onDelete: Restrict)
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  installmentNumber Int
  dueDate           DateTime
  principalAmount   Float
  interestAmount    Float
  totalAmount       Float
  paidAmount        Float           @default(0)
  status            String          @default("UPCOMING") // UPCOMING, DUE, PAID, PARTIALLY_PAID, OVERDUE
  paidAt            DateTime?

  payments          Payment[]

  @@index([loanId])
  @@index([customerId])
  @@index([dueDate])
  @@index([status])
}

// -------------------------------------------------------------
// 8. PAYMENT & REPAYMENT
// -------------------------------------------------------------
model Payment {
  id             String          @id @default(uuid())
  loanId         String
  loan           LoanApplication @relation(fields: [loanId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  emiScheduleId  String?
  emiSchedule    EMISchedule?    @relation(fields: [emiScheduleId], references: [id], onDelete: SetNull)
  
  amount         Float
  paymentMethod  String          // UPI, NET_BANKING, DEBIT_CARD, MOCK
  paymentType    String          @default("PROCESSING_FEE") // PROCESSING_FEE, EMI_REPAYMENT
  transactionRef String          @unique
  receiptNumber  String          @unique
  status         String          @default("SUCCESS") // PENDING, UNDER_VERIFICATION, SUCCESS, PAID, FAILED, REJECTED
  verifiedBy     String?
  verifiedAt     DateTime?
  rejectionReason String?
  notes          String?
  paymentDate    DateTime        @default(now())

  @@index([loanId])
  @@index([customerId])
  @@index([transactionRef])
  @@index([receiptNumber])
  @@index([status])
}

// -------------------------------------------------------------
// 9. NOTIFICATION
// -------------------------------------------------------------
model Notification {
  id            String    @id @default(uuid())
  recipientType String    // CUSTOMER, ADMIN
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  title         String
  message       String
  eventType     String    // REGISTRATION, LOAN_STATUS, EMI_REMINDER, etc.
  isRead        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([recipientType])
  @@index([customerId])
  @@index([isRead])
}

// -------------------------------------------------------------
// 10. AUDIT LOG (Immutable)
// -------------------------------------------------------------
model AuditLog {
  id            String    @id @default(uuid())
  actorType     String    // ADMIN, CUSTOMER, SYSTEM
  actorId       String?
  actorName     String
  action        String    // APPROVE_LOAN, MODIFY_AMOUNT, DISBURSE, etc.
  entity        String    // LoanApplication, Customer, Document, etc.
  entityId      String
  previousValue String?   // JSON stringified before state
  newValue      String?   // JSON stringified after state
  ipAddress     String?
  timestamp     DateTime  @default(now())

  @@index([entity])
  @@index([entityId])
  @@index([timestamp])
  @@index([actorId])
}

// -------------------------------------------------------------
// 11. BRANDING & SYSTEM SETTINGS
// -------------------------------------------------------------
model BrandingSettings {
  id              String   @id @default("default")
  companyName     String   @default("Loan Approve Financial Services")
  appName         String   @default("Loan Approve")
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String   @default("#047857")
  secondaryColor  String   @default("#0f172a")
  email           String   @default("support@loanapprove.com")
  phone           String   @default("+91 98765 43210")
  address         String   @default("Nariman Point, Mumbai, Maharashtra 400021")
  website         String   @default("https://loanapprove.com")
  termsUrl        String   @default("https://loanapprove.com/terms")
  privacyUrl      String   @default("https://loanapprove.com/privacy")
  updatedAt       DateTime @updatedAt
}

// -------------------------------------------------------------
// 12. SUPPORT TICKET
// -------------------------------------------------------------
model SupportTicket {
  id          String    @id @default(uuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subject     String
  message     String
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  adminReply  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([customerId])
  @@index([status])
}

// -------------------------------------------------------------
// 13. EMAIL SETTINGS (SMTP)
// -------------------------------------------------------------
model EmailSettings {
  id              String   @id @default("default")
  smtpHost        String   @default("")
  smtpPort        Int      @default(587)
  smtpUsername    String   @default("")
  smtpPasswordEnc String   @default("")
  fromName        String   @default("Loan Approve Financial Services")
  fromEmail       String   @default("notifications@loanapprove.com")
  encryption      String   @default("STARTTLS") // NONE, SSL, STARTTLS
  updatedAt       DateTime @updatedAt
}

// -------------------------------------------------------------
// 14. WHATSAPP SETTINGS
// -------------------------------------------------------------
model WhatsAppSettings {
  id                String   @id @default("default")
  provider          String   @default("META") // META, TWILIO, GUPSHUP
  phoneNumber       String   @default("")
  phoneNumberId     String   @default("")
  businessAccountId String   @default("")
  apiEndpoint       String   @default("")
  accessTokenEnc    String   @default("")
  enabled           Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

// -------------------------------------------------------------
// 15. PAYMENT CONFIGURATION
// -------------------------------------------------------------
model PaymentConfig {
  id                String   @id @default("default")
  chargeAmount      Float    @default(500)
  chargeType        String   @default("PROCESSING_DEPOSIT") // PROCESSING_DEPOSIT, VERIFICATION_FEE
  upiId             String   @default("pay@loanapprove")
  accountNumber     String   @default("9876543210123")
  ifscCode          String   @default("HDFC0001234")
  accountHolderName String   @default("Loan Approve Financial Services")
  instructions      String   @default("Please transfer the processing fee using UPI or IMPS and enter the 12-digit UTR number below.")
  updatedAt         DateTime @updatedAt
}

