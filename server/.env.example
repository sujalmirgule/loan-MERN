# ============================================================
# LOAN APPROVE — SERVER PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================

# General Server Settings
PORT=5000
NODE_ENV=production

# Frontend Client URL (CORS & PDF Verification Links)
CLIENT_URL=https://loanapprove.com

# Production MySQL Database Connection String
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?ssl-mode=REQUIRED
DATABASE_URL=

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_32_plus_char_secret_key
JWT_EXPIRES_IN=7d

# Initial Production System Admin Account Credentials (Used during initial seed)
ADMIN_EMAIL=admin@loanapprove.com
ADMIN_PASSWORD=SecureAdminPassword123!

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Seeding Mode
# Set to 'false' for production (seeds system defaults & admin ONLY, NO fake data)
# Set to 'true' for dev/test environments (seeds demo customers & loans)
SEED_DEMO_DATA=false

# Communication Services Configuration — Email (SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=notifications@loanapprove.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_NAME="Loan Approve Financial Services"
SMTP_FROM_EMAIL="notifications@loanapprove.com"
SMTP_SECURE=false

# Communication Services Configuration — WhatsApp (Meta Cloud API / WABridge)
WHATSAPP_PROVIDER=meta
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_VERSION=v18.0
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_PHONE_NUMBER=+919876543210
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
