# ============================================================
# LOAN APPROVE — ROOT PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================

# General Server Settings
NODE_ENV=production
PORT=5000

# Frontend SPA Origin URL
CLIENT_URL=https://loanapprove.com

# Production MySQL Database Connection String
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?ssl-mode=REQUIRED
DATABASE_URL=

# Authentication Secrets (Minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Initial Production Master Admin Credentials
ADMIN_EMAIL=admin@loanapprove.com
ADMIN_PASSWORD=ChangeThisSecurePassword123!

# Storage Options
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Production Seed Data Guard (false = no fake customers/loans)
SEED_DEMO_DATA=false

# Email (SMTP) Service Configuration
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=notifications@loanapprove.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_NAME="Loan Approve Financial Services"
SMTP_FROM_EMAIL="notifications@loanapprove.com"
SMTP_SECURE=false

# WhatsApp Service Configuration (Meta Cloud API / WABridge)
WHATSAPP_PROVIDER=meta
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_VERSION=v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_PHONE_NUMBER=+919876543210
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
